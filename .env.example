# ==============================
# 基础服务配置
# ==============================
APP_URL=http://localhost:3600
PARTNER_NAME=老婆
DEFAULT_PERIOD_DAYS=28
DEFAULT_MENSES_DAYS=5

# ==============================
# QQ 邮箱提醒设置 (选填，也可在网页端直接设置)
# ==============================
# 发件人 QQ 邮箱
SMTP_USER=your_email@qq.com
# QQ 邮箱 SMTP 授权码（设置 -> 账户 -> 开启POP3/SMTP服务生成）
SMTP_PASS=your_smtp_authorization_code
# 接收人邮箱列表，支持英文逗号分隔填入夫妻/情侣双方邮箱
EMAIL_TO=your_partner@qq.com, your_email@qq.com
# 提前提醒天数与提醒发送时间（24小时制）
REMIND_DAYS_BEFORE=3
REMIND_TIME=08:00

# ==============================
# 微信服务号/测试号服务通知 (选填，也可在网页端直接设置)
# ==============================
# 微信公众平台测试账号 AppID 与 AppSecret (https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login)
WECHAT_APPID=
WECHAT_SECRET=
# 微信模板消息 ID
WECHAT_TEMPLATE_ID=
